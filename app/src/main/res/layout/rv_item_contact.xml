<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/transparent_color"
    android:orientation="vertical">
    <LinearLayout
        android:id="@+id/item_faq_lv_clicked_no"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/padding_5"
        android:orientation="vertical"
        android:visibility="visible">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="@dimen/padding_5"
            android:paddingBottom="@dimen/padding_5">
            <TextView
                android:id="@+id/item_faq_title_no"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_gravity="start|center"
                android:text="@string/contactus"
                android:textColor="@color/white_color"
                android:textSize="@dimen/text_15"
                android:gravity="center_vertical"/>
            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:padding="5dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_right_back"
                app:tint="@color/white_color" />
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_marginTop="@dimen/margin_10"
            android:background="@color/grey_dark"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/item_faq_lv_clicked_yes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/padding_5"
        android:orientation="horizontal"
        android:visibility="gone">
        <ImageView
            android:layout_width="5dp"
            android:layout_height="match_parent"
            android:src="@drawable/bg_contact_item"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginStart="@dimen/margin_10"
                android:paddingTop="@dimen/padding_5"
                android:gravity="center"
                android:layout_gravity="center"
                android:paddingBottom="@dimen/padding_5">
                <TextView
                    android:id="@+id/item_faq_title_yes"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:singleLine="true"
                    android:ellipsize="marquee"
                    android:textColor="@color/white_color"
                    android:textSize="@dimen/text_15"
                    android:gravity="center_vertical"/>
                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:padding="5dp"
                    android:layout_gravity="center"
                    android:src="@drawable/down_light"
                    app:tint="@color/white_color" />
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:background="@color/grey_light"/>
        </LinearLayout>

    </LinearLayout>
    <TextView
        android:id="@+id/item_faq_tv_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/padding_10"
        android:layout_margin="@dimen/margin_5"
        android:background="@drawable/bg_round_rect"
        android:textColor="@color/grey_light"
        android:textSize="@dimen/text_15"
        android:visibility="gone"/>
</LinearLayout>