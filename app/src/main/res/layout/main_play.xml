<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/black_color"
    android:padding="@dimen/margin_15"
    android:clickable="true"
    android:orientation="vertical"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/li_5"
        android:layout_alignParentTop="true"
        android:layout_width="match_parent"
        android:layout_height="@dimen/margin_60">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="0.2"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/close"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/down_black"
                android:padding="@dimen/margin_18"
                />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="0.6"
            android:layout_height="match_parent"
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:textSize="@dimen/text_17"
                android:textColor="@color/green_dark"
                android:text="@string/now_playing"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/green_dark"
                android:text="@string/recent_played"
                android:visibility="gone"
                android:gravity="center"
                />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="0.2"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/list"
                android:visibility="invisible"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_list"
                android:padding="@dimen/margin_15"
                app:tint="@color/white_color" />
        </LinearLayout>
    </LinearLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/li_5"
        android:layout_above="@id/li_3">
        <LinearLayout
            android:id="@+id/li_4"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"
            android:padding="@dimen/margin_20">
            <com.pierfrancescosoffritti.androidyoutubeplayer.core.player.views.YouTubePlayerView
                android:id="@+id/youtube_player_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:showFullScreenButton="false"
                app:showSeekBar="false"
                android:visibility="visible"
                app:showVideoCurrentTime="false"
                app:showVideoDuration="false"
                app:showYouTubeButton="false" />
<!--            <com.google.android.exoplayer2.ui.SimpleExoPlayerView-->
<!--                android:id="@+id/youtube_player_view"-->
<!--                android:focusable="true"-->
<!--                android:background="@color/black_color"-->
<!--                android:layout_width="match_parent"-->
<!--                android:layout_height="match_parent"-->
<!--                app:use_controller="false"-->
<!--                android:layout_below="@+id/resolution_textView"/>-->

        </LinearLayout>
        <com.makeramen.roundedimageview.RoundedImageView
            android:id="@+id/cover_img"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"

            app:riv_corner_radius="@dimen/margin_10"
            android:padding="@dimen/margin_20"
            android:layout_marginLeft="@dimen/margin_20"
            android:layout_marginRight="@dimen/margin_20"
            />
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/li_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/margin_5"
        android:layout_marginBottom="@dimen/margin_10"
        android:layout_above="@id/li_2"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="0.8"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            >
            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white_color"
                android:textStyle="bold"
                android:textSize="@dimen/text_20"
                />
            <TextView
                android:id="@+id/artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_17"
                android:textColor="@color/white_color"
                />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="0.15"
            android:gravity="center"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/main_favorite"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="@dimen/margin_5"
                android:layout_marginStart="@dimen/margin_10"
                android:layout_gravity="center"
                android:src="@drawable/favorite_heart"
                app:tint="@color/green_dark" />
        </LinearLayout>

    </LinearLayout>
    <LinearLayout
        android:id="@+id/li_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/li_1"
        android:layout_marginBottom="@dimen/margin_10"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_10"
            android:layout_marginEnd="@dimen/margin_10"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/start"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="@color/white_color"
                />
            <TextView
                android:id="@+id/end"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:gravity="end"
                android:textColor="@color/white_color"
                />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <SeekBar
                android:id="@+id/seekbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:progress="0"
                android:theme="@style/SeekbarTheme"
                android:thumb="@drawable/icon_play_thumb"
                />
<!--            <com.pierfrancescosoffritti.androidyoutubeplayer.core.ui.views.YouTubePlayerSeekBar-->
<!--                android:id="@+id/youtube_player_seekbar"-->
<!--                android:layout_width="match_parent"-->
<!--                android:layout_height="wrap_content"-->
<!--                app:fontSize="12sp"-->
<!--                app:color="@color/green_dark" />-->
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/li_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/li_0"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="0.2"
            android:layout_gravity="center"
            android:gravity="center"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/shuffle"
                android:layout_width="@dimen/margin_50"
                android:layout_height="@dimen/margin_50"
                android:padding="@dimen/margin_10"
                android:visibility="visible"
                android:src="@drawable/ic_shuffle" />

        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="0.6"
            android:orientation="horizontal"
            android:layout_gravity="center"
            android:gravity="center"
            android:layout_height="wrap_content">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_gravity="center"
                android:gravity="center"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/prev"
                    android:layout_width="@dimen/margin_40"
                    android:layout_height="@dimen/margin_40"
                    android:src="@drawable/player_backward"
                    />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_gravity="center"
                android:gravity="center"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/play"
                    android:layout_width="@dimen/margin_50"
                    android:layout_height="@dimen/margin_50"
                    android:src="@drawable/ic_play"
                    app:tint="@color/white_color" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_gravity="center"
                android:gravity="center"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/next"
                    android:layout_width="@dimen/margin_40"
                    android:layout_height="@dimen/margin_40"
                    android:src="@drawable/player_forward"
                    />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="0.2"
            android:layout_gravity="center"
            android:gravity="center"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/repeat"
                android:layout_width="@dimen/margin_50"
                android:layout_height="@dimen/margin_50"
                android:src="@drawable/ic_repeat"
                android:padding="@dimen/margin_10"
                android:visibility="visible" />

        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/li_0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/li_00"
        android:layout_marginBottom="@dimen/margin_20"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="0.2"
            android:layout_gravity="center"
            android:gravity="center"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/more"
                android:layout_width="@dimen/margin_40"
                android:layout_height="@dimen/margin_30"
                android:src="@drawable/more"
                android:padding="@dimen/margin_5"
                app:tint="@color/white_color" />

        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="0.6"
            android:orientation="horizontal"
            android:layout_gravity="center"
            android:gravity="center"
            android:layout_height="wrap_content"/>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="0.2"
            android:layout_gravity="center"
            android:gravity="center"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/share"
                android:layout_width="@dimen/margin_40"
                android:layout_height="@dimen/margin_30"
                android:src="@drawable/ic_share"
                android:padding="@dimen/margin_3"
                app:tint="@color/white_color" />

        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/li_00"
        android:layout_width="match_parent"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_height="wrap_content">
        <LinearLayout
            android:id="@+id/li_volume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:visibility="visible"
            >
            <ImageView
                android:layout_width="@dimen/margin_22"
                android:layout_height="@dimen/margin_22"
                android:layout_gravity="center"
                android:src="@drawable/ic_volume_start"
                app:tint="@color/white_color" />
            <SeekBar
                android:id="@+id/volume_seekbar"
                android:layout_width="150dp"
                android:layout_height="wrap_content"
                android:progress="0"
                android:theme="@style/SeekbarTheme"
                android:thumb="@drawable/icon_play_thumb"
                />
            <ImageView
                android:layout_width="@dimen/margin_22"
                android:layout_height="@dimen/margin_22"
                android:layout_gravity="center"
                android:src="@drawable/ic_volume_end"
                app:tint="@color/white_color" />

        </LinearLayout>

    </LinearLayout>
</RelativeLayout>