<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_detail_bottom"
    android:orientation="vertical"
    >
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/margin_10"
        android:orientation="vertical"
        android:gravity="center">
        <com.makeramen.roundedimageview.RoundedImageView
            android:id="@+id/image"
            android:layout_width="130dp"
            android:layout_height="130dp"
            android:layout_marginTop="@dimen/margin_15"
            app:riv_corner_radius="@dimen/margin_5"
            android:layout_gravity="center"/>
        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="@dimen/margin_10"
            android:layout_gravity="center"
            android:textColor="@color/white_color"
            android:textSize="@dimen/text_15"
            />
        <TextView
            android:id="@+id/artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="@dimen/margin_5"
            android:layout_gravity="center"
            android:textColor="@color/grey_dark"
            android:textSize="@dimen/text_15"
            />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/margin_10"
        android:layout_marginBottom="@dimen/margin_30"
        android:orientation="vertical">
        <LinearLayout
            android:id="@+id/li_download"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/download"
                android:layout_width="@dimen/margin_50"
                android:layout_height="@dimen/margin_50"
                android:padding="12dp"
                android:src="@drawable/ic_download"
                android:layout_gravity="center"
                app:tint="@color/green_dark" />
            <TextView
                android:id="@+id/txt_download"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_18"
                android:layout_gravity="center"
                android:layout_marginLeft="@dimen/margin_5"
                android:textColor="@color/white_color"
                android:text="@string/download"
                />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/li_downloading"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ProgressBar
                android:id="@+id/download_loading"
                android:layout_width="@dimen/margin_50"
                android:layout_height="@dimen/margin_50"
                android:layout_gravity="center"
                android:padding="12dp"
                android:indeterminateDrawable="@drawable/loading_green"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_18"
                android:layout_gravity="center"
                android:layout_marginLeft="@dimen/margin_5"
                android:textColor="@color/white_color"
                android:text="@string/downloaded"
                />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/li_favorite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/favorite"
                android:layout_width="@dimen/margin_50"
                android:layout_height="@dimen/margin_50"
                android:padding="12dp"
                android:src="@drawable/unfavorite_heart"
                android:layout_gravity="center"
                app:tint="@color/green_dark" />
            <TextView
                android:id="@+id/txt_add_favorite"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_18"
                android:layout_gravity="center"
                android:layout_marginLeft="@dimen/margin_5"
                android:textColor="@color/white_color"
                android:text="@string/add_favorite"
                />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/add_playlist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_gravity="center"
                android:padding="12dp"
                android:src="@drawable/ic_playlist"
                app:tint="@color/white_color" />
            <TextView
                android:id="@+id/txt_playlist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_18"
                android:layout_gravity="center"
                android:layout_marginLeft="@dimen/margin_5"
                android:textColor="@color/white_color"
                android:text="@string/add_playlist"
                />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/rename"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_width="@dimen/margin_50"
                android:layout_height="@dimen/margin_50"
                android:padding="12dp"
                android:src="@drawable/ic_rename"
                android:layout_gravity="center"
                app:tint="@color/white_color" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_18"
                android:layout_gravity="center"
                android:layout_marginLeft="@dimen/margin_5"
                android:textColor="@color/white_color"
                android:text="@string/rename_song"
                />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/fix"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_width="@dimen/margin_50"
                android:layout_height="@dimen/margin_50"
                android:padding="12dp"
                android:src="@drawable/ic_fix"
                android:layout_gravity="center"
                app:tint="@color/white_color" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_18"
                android:layout_gravity="center"
                android:layout_marginLeft="@dimen/margin_5"
                android:textColor="@color/white_color"
                android:text="@string/fix_song"
                />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>