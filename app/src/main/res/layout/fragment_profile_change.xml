<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black_color">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/margin_60">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center">
            <ImageView
                android:id="@+id/back"
                android:layout_width="@dimen/margin_40"
                android:layout_height="@dimen/margin_40"
                android:padding="@dimen/margin_10"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_arrow"
                android:layout_alignParentStart="true"
                app:tint="@color/white_color" />
            <TextView
                android:id="@+id/setting_title"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/profile_info"
                android:textColor="@color/white_color"
                android:textSize="@dimen/text_18"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_centerInParent="true"
                />
        </RelativeLayout>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="@dimen/margin_40"
            android:paddingRight="@dimen/margin_40"
            android:layout_marginTop="@dimen/margin_5"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:paddingLeft="@dimen/margin_10"
                android:paddingRight="@dimen/margin_10"
                android:gravity="center"
                >
                <LinearLayout
                    android:layout_width="140dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:gravity="center">
                    <RelativeLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:layout_centerHorizontal="true"
                        tools:ignore="ObsoleteLayoutParam">
                        <de.hdodenhof.circleimageview.CircleImageView
                            android:id="@+id/profile"
                            android:layout_height="120dp"
                            android:layout_width="120dp"
                            app:civ_border_color="@color/grey_dark"
                            app:civ_border_width="1dp"
                            android:alpha="0.8"
                            android:src="@drawable/ic_profile"
                            app:riv_border_color="@color/grey_dark"
                            app:riv_corner_radius="@dimen/margin_50"
                            />

                        <ImageView
                            android:id="@+id/submit"
                            android:layout_width="@dimen/margin_50"
                            android:layout_height="@dimen/margin_50"
                            android:layout_alignBottom="@+id/profile"
                            android:layout_alignParentStart="true"
                            android:padding="@dimen/padding_10"
                            android:layout_marginStart="90dp"
                            android:src="@drawable/ic_camera" />
                    </RelativeLayout>

                </LinearLayout>
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/change_alert"
                android:textColor="@color/grey_dark"
                android:layout_marginLeft="@dimen/padding_5"
                android:layout_marginRight="@dimen/padding_5"
                android:textSize="@dimen/text_15"
                />
            <EditText
                android:id="@+id/et_pass"
                android:layout_width="match_parent"
                android:layout_height="@dimen/margin_40"
                android:textColor="@color/white_color"
                android:inputType="textPassword"
                android:hint="@string/cur_password"
                android:textColorHint="@color/grey_dark"
                android:background="@drawable/bg_edit"
                android:paddingLeft="@dimen/margin_15"
                android:paddingRight="@dimen/margin_15"
                android:layout_marginTop="@dimen/margin_10"/>
            <EditText
                android:id="@+id/et_email"
                android:layout_width="match_parent"
                android:layout_height="@dimen/margin_40"
                android:textColor="@color/white_color"
                android:paddingLeft="@dimen/margin_15"
                android:paddingRight="@dimen/margin_15"
                android:background="@drawable/bg_edit"
                android:inputType="textEmailAddress"
                android:layout_marginTop="@dimen/margin_30"/>
            <EditText
                android:id="@+id/et_firstname"
                android:layout_width="match_parent"
                android:layout_height="@dimen/margin_40"
                android:textColor="@color/white_color"
                android:background="@drawable/bg_edit"
                android:paddingLeft="@dimen/margin_15"
                android:paddingRight="@dimen/margin_15"
                android:layout_marginTop="@dimen/margin_15"/>
            <EditText
                android:id="@+id/et_lastname"
                android:layout_width="match_parent"
                android:layout_height="@dimen/margin_40"
                android:textColor="@color/white_color"
                android:paddingLeft="@dimen/margin_15"
                android:paddingRight="@dimen/margin_15"
                android:background="@drawable/bg_edit"
                android:layout_marginTop="@dimen/margin_15"/>
            <androidx.cardview.widget.CardView
                android:id="@+id/main_shuffle"
                android:layout_width="150dp"
                android:layout_height="@dimen/margin_40"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/margin_30"
                android:paddingBottom="@dimen/margin_80"
                android:layout_marginBottom="@dimen/margin_80"
                app:cardBackgroundColor="@color/green_dark"
                app:cardCornerRadius="@dimen/margin_20"
                app:cardElevation="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center">
                    <TextView
                        android:id="@+id/btn_change"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="@string/change"
                        android:gravity="center"
                        android:textAllCaps="false"
                        android:textColor="@color/black_color"
                        android:textSize="@dimen/text_15"/>
                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>



</LinearLayout>