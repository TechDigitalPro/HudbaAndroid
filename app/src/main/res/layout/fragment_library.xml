<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:background="@drawable/fragment_bg"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/parent"
        android:layout_height="140dp"
        android:layout_width="match_parent"
        android:background="@color/transparent_color"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar">
        <!-- contentScrim is used for -->
        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsingToolbar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:contentScrim="?attr/colorPrimary"
            app:layout_scrollFlags="scroll|exitUntilCollapsed">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingRight="@dimen/margin_20"
                android:layout_marginTop="@dimen/margin_10">

                <ImageView
                    android:id="@+id/btn_profile"
                    android:layout_width="@dimen/margin_30"
                    android:layout_height="@dimen/margin_30"
                    android:layout_marginTop="@dimen/margin_15"
                    android:layout_alignParentRight="true"
                    android:src="@drawable/ic_profile" />
                <LinearLayout
                    android:id="@+id/li_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/margin_60"
                        android:textSize="@dimen/text_25"
                        android:textStyle="bold"
                        android:paddingStart="@dimen/margin_20"
                        android:layout_marginTop="@dimen/margin_10"
                        android:gravity="bottom"
                        android:textColor="@color/white_color"
                        app:layout_collapseMode="parallax"
                        android:text="@string/library"
                        />
                </LinearLayout>
            </RelativeLayout>

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:layout_collapseMode="pin"
                android:layout_gravity="right|bottom"
                app:popupTheme="@style/ThemeOverlay.AppCompat.Light">
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_20"
                    android:layout_marginEnd="@dimen/margin_20"
                    android:background="@drawable/bk_search_bar">
                    <AutoCompleteTextView
                        android:id="@+id/search_txt"
                        android:layout_width="match_parent"
                        android:layout_centerInParent="true"
                        android:layout_centerVertical="true"
                        android:layout_height="38dp"
                        android:maxLines="1"
                        android:inputType="text"
                        android:singleLine="true"
                        android:background="@android:color/transparent"
                        android:paddingLeft="@dimen/margin_15"
                        android:paddingRight="@dimen/padding_15"
                        android:drawableEnd="@drawable/ic_close"
                        android:hint="Search playlists in your library..."
                        android:paddingStart="@dimen/padding_15"
                        android:imeOptions="actionSearch"
                        android:imeActionId="666"
                        android:drawableStart="@drawable/search_dialog_ic_search"/>
                </RelativeLayout>
            </androidx.appcompat.widget.Toolbar>

        </com.google.android.material.appbar.CollapsingToolbarLayout>

    </com.google.android.material.appbar.AppBarLayout>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingBottom="@dimen/margin_80"
            android:layout_marginLeft="@dimen/margin_20"
            android:layout_marginRight="@dimen/margin_20"
            android:layout_marginTop="@dimen/margin_20"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">
                <LinearLayout
                    android:id="@+id/li_saved"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.makeramen.roundedimageview.RoundedImageView
                        android:id="@+id/saved_song_image"
                        android:layout_width="@dimen/margin_60"
                        android:layout_height="@dimen/margin_60"
                        app:riv_corner_radius="@dimen/margin_10"
                        android:src="@drawable/aaa"
                        />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginLeft="@dimen/margin_15"
                        android:layout_gravity="center"
                        >
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/saved_song"
                            android:textColor="@color/white_color"
                            android:textSize="@dimen/text_17"
                            />
                        <TextView
                            android:id="@+id/song_cnt"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_5"
                            android:textSize="@dimen/text_15"
                            android:textColor="@color/grey_dark"
                            />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:layout_marginTop="@dimen/margin_10"
                    >
                    <com.makeramen.roundedimageview.RoundedImageView
                        android:id="@+id/artist_image"
                        android:layout_width="@dimen/margin_60"
                        android:layout_height="@dimen/margin_60"
                        app:riv_corner_radius="@dimen/margin_10"
                        android:src="@drawable/aaa"
                        />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginLeft="@dimen/margin_15"
                        android:layout_gravity="center"
                        >
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/artist"
                            android:textColor="@color/white_color"
                            android:textSize="@dimen/text_17"
                            />
                        <TextView
                            android:id="@+id/artist_cnt"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_5"
                            android:textSize="@dimen/text_15"
                            android:textColor="@color/grey_dark"
                            />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/li_playlist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_30">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="@string/playlist"
                        android:layout_gravity="center"
                        android:textStyle="bold"
                        android:textColor="@color/white_color"
                        android:textSize="@dimen/text_22"
                        />
                    <ImageView
                        android:id="@+id/filter_playlist"
                        android:layout_width="@dimen/margin_50"
                        android:layout_height="@dimen/margin_50"
                        android:paddingLeft="@dimen/padding_20"
                        android:paddingBottom="12dp"
                        android:paddingTop="12dp"
                        android:visibility="invisible"
                        android:src="@drawable/ic_list"
                        android:layout_gravity="center"
                        app:tint="@color/white_color" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/li_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_10"
                    android:orientation="vertical">
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_playlist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <RelativeLayout
        android:id="@+id/add_playlist"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="right|bottom"
        android:layout_marginBottom="@dimen/margin_20"
        android:layout_marginRight="@dimen/margin_20"
        >
        <LinearLayout
            android:layout_width="@dimen/margin_50"
            android:layout_height="@dimen/margin_50"
            android:background="@drawable/bg_round_rect"
            />
        <ImageView
            android:layout_width="@dimen/margin_30"
            android:layout_height="@dimen/margin_30"
            android:src="@drawable/ic_plus"
            android:layout_centerInParent="true"
            app:tint="@color/white_color" />
    </RelativeLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>