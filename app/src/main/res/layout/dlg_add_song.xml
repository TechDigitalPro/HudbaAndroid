<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:background="@android:color/transparent">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="550dp"
        android:layout_gravity="center"
        android:gravity="center"
        android:layout_marginLeft="@dimen/margin_10"
        android:layout_marginRight="@dimen/margin_10"
        app:cardCornerRadius="10dp"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/orange_brown"
            android:orientation="vertical">
            <LinearLayout
                android:id="@+id/infoTitle"
                android:layout_width="match_parent"
                android:layout_height="480dp"
                android:orientation="vertical"
                tools:ignore="MissingConstraints">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingLeft="20dp"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/title"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="match_parent"
                        android:layout_marginLeft="10dp"
                        android:gravity="top"
                        android:layout_marginTop="@dimen/margin_15"
                        android:text="@string/add_song"
                        android:textColor="@color/white_color"
                        android:textSize="@dimen/text_20"
                        android:textStyle="bold" />
                    <ImageView
                        android:id="@+id/btn_close"
                        android:layout_width="50dp"
                        android:layout_height="match_parent"
                        android:padding="@dimen/margin_10"
                        android:layout_gravity="right|center"
                        android:layout_marginTop="@dimen/padding_5"
                        android:layout_marginRight="@dimen/padding_5"
                        android:src="@drawable/ic_close"
                        />
                </LinearLayout>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="@dimen/margin_20"
                    android:layout_marginLeft="@dimen/margin_20"
                    android:orientation="vertical">
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_20"
                        android:background="@drawable/bk_search_bar">
                        <androidx.appcompat.widget.SearchView
                            android:id="@+id/add_search_txt"
                            android:layout_width="match_parent"
                            android:layout_centerInParent="true"
                            android:layout_centerVertical="true"
                            android:layout_height="@dimen/margin_30"
                            app:queryHint="@string/search" />
                    </RelativeLayout>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/li_rv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_10"
                    android:paddingTop="@dimen/margin_5"
                    android:visibility="visible"
                    android:paddingBottom="@dimen/margin_5"
                    >
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_list"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/li_empty"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="@dimen/margin_100"
                    android:visibility="gone"
                    android:orientation="vertical"
                    >
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="@string/empty_song"
                        android:layout_gravity="center"
                        android:textColor="@color/white_color"
                        android:textSize="@dimen/text_20"
                        android:gravity="center"
                        />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="@string/empty_song1"
                        android:layout_gravity="center"
                        android:layout_marginLeft="@dimen/margin_20"
                        android:layout_marginRight="@dimen/margin_20"
                        android:textColor="@color/grey_dark"
                        android:textSize="@dimen/text_15"
                        android:gravity="center"
                        />
                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="bottom"
                android:gravity="bottom"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/add_btn"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/margin_35"
                    android:layout_marginLeft="@dimen/margin_40"
                    android:layout_marginRight="@dimen/margin_40"
                    android:layout_marginBottom="@dimen/margin_10"
                    android:layout_gravity="center_horizontal|bottom"
                    android:background="@drawable/bk_login_button_primary"
                    android:textColor="@color/black_color"
                    android:textSize="@dimen/text_15"
                    android:text="@string/add_playlist"/>

            </LinearLayout>


        </LinearLayout>
    </androidx.cardview.widget.CardView>
</FrameLayout>